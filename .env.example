# AIC — variáveis opcionais. Copie para ~/.config/aic/.env e preencha só o que usar:
#
#   mkdir -p ~/.config/aic && cp .env.example ~/.config/aic/.env && chmod 600 ~/.config/aic/.env
#
# Formato: CHAVE=valor (uma por linha). Linhas com # são comentário; aspas são opcionais.
# O AIC lê este arquivo ao abrir e NÃO sobrescreve variáveis que já estejam no ambiente.
# Valores definidos aqui têm prioridade sobre o config.toml.

# ---------------------------------------------------------------- Notion
# Só necessário com o conector "Token" (Config → Integrações). Com o conector "Claude",
# o AIC usa os conectores do Notion/Slack já ligados na sua conta do Claude.
# Crie uma integração interna em https://www.notion.so/profile/integrations e
# compartilhe as databases com ela.
NOTION_TOKEN=

# Id da database (ou data source) de tasks/cards. Aceita o id da database ou do data source.
AIC_NOTION_TASKS_DB=

# Id da database de sprints (para filtrar pela sprint atual). Opcional.
AIC_NOTION_SPRINTS_DB=

# Você no Notion (e-mail ou id de usuário), para o filtro "só meus cards".
AIC_NOTION_ME=

# Prefixo da chave dos cards quando o ID do Notion não tem prefixo próprio (ex: DEV → DEV-123).
AIC_NOTION_KEY_PREFIX=

# ---------------------------------------------------------------- Repositórios
# Pastas onde o AIC procura repositórios (subpastas com .git), separadas por ":".
# Aceita ~. Padrão: a sua home.
# Ex: AIC_REPOS_DIRS=~/projetos:~/trabalho/repos
AIC_REPOS_DIRS=

# ---------------------------------------------------------------- Slack
# URL do seu workspace do Slack. Guardada em config (slack.workspace_url) para as
# integrações; hoje os links de thread colados nos cards já funcionam sem ela.
# Ex: SLACK_WORKSPACE_URL=https://seu-time.slack.com
SLACK_WORKSPACE_URL=
