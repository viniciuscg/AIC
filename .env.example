# AIC — variáveis opcionais. Copie para ~/.config/aic/.env e preencha só o que usar:
#
#   mkdir -p ~/.config/aic && cp .env.example ~/.config/aic/.env && chmod 600 ~/.config/aic/.env
#
# Formato: CHAVE=valor (uma por linha). Linhas com # são comentário; aspas são opcionais.
# O AIC lê este arquivo ao abrir e NÃO sobrescreve variáveis que já estejam no ambiente.
# Valores definidos aqui têm prioridade sobre o config.toml.

# ---------------------------------------------------------------- Repositórios
# Pastas onde o AIC procura repositórios (subpastas com .git), separadas por ":".
# Aceita ~. Padrão: a sua home.
# Ex: AIC_REPOS_DIRS=~/projetos:~/trabalho/repos
AIC_REPOS_DIRS=

# ---------------------------------------------------------------- Layne (voz)
# Só se a transcrição for por API (Config → Layne → Transcrição). O nome da variável
# é configurável; estes são os dos atalhos "OpenAI" e "Groq" da tela.
OPENAI_API_KEY=
GROQ_API_KEY=
